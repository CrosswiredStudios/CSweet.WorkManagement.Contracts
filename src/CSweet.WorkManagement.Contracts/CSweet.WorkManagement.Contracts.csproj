<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <PackageId>CSweet.WorkManagement.Contracts</PackageId>
    <Version>1.2.0</Version>
    <PackageVersion Condition="'$(CSweetWorkManagementContractsPackageVersion)' != ''">$(CSweetWorkManagementContractsPackageVersion)</PackageVersion>
    <Authors>C-Sweet</Authors>
    <Company>C-Sweet</Company>
    <Description>Wire contracts and capability names for C-Sweet work management.</Description>
    <PackageTags>csweet;agents;contracts;kanban;work-management</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/CrosswiredStudios/CSweet.WorkManagement.Contracts</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
